# ===================================================================
# 🐄 SMART DAIRY MANAGEMENT - ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to .env and fill in your actual Supabase credentials.
# ===================================================================

# 1. SUPABASE PROJECT API CREDENTIALS
# (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. SUPABASE POSTGRESQL DATABASE CONNECTION
# (Found in Supabase Dashboard -> Project Settings -> Database -> Connection String)
# Example: jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your-database-password-here

# Active Spring Profile (Set to 'supabase' to connect to cloud PostgreSQL)
SPRING_PROFILES_ACTIVE=supabase

# 3. PORTS & ENDPOINTS
PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
